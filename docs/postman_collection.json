{
    "info": {
        "name": "Farmers Market Platform API",
        "description": "Backend API for Farmers Market Platform - Laravel REST API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [{"key": "Content-Type", "value": "application/json"}],
                        "url": "{{base_url}}/api/v1/auth/login",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}"
                        }
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/v1/auth/logout"
                    }
                }
            ]
        },
        {
            "name": "Users",
            "item": [
                {
                    "name": "List Users",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                        "url": "{{base_url}}/api/v1/users"
                    }
                },
                {
                    "name": "Create User",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/v1/users",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password\",\n  \"role\": \"operator\",\n  \"supervisor_id\": 1\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Farmers",
            "item": [
                {
                    "name": "List Farmers",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                        "url": "{{base_url}}/api/v1/farmers"
                    }
                },
                {
                    "name": "Create Farmer",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/v1/farmers",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Moussa Traore\",\n  \"card_id\": \"FARM-001\",\n  \"phone\": \"+22370000001\",\n  \"credit_limit\": 50000\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Catalog",
            "item": [
                {
                    "name": "List Categories",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                        "url": "{{base_url}}/api/v1/categories"
                    }
                },
                {
                    "name": "List Products",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                        "url": "{{base_url}}/api/v1/products"
                    }
                }
            ]
        },
        {
            "name": "Transactions",
            "item": [
                {
                    "name": "Create Cash Transaction",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/v1/transactions",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"farmer_id\": 1,\n  \"payment_method\": \"cash\",\n  \"items\": [\n    {\"product_id\": 1, \"quantity\": 2}\n  ]\n}"
                        }
                    }
                },
                {
                    "name": "Validate Offline Transaction",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/v1/transactions/validate",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"farmer_id\": 1,\n  \"payment_method\": \"credit\",\n  \"items\": [\n    {\"product_id\": 1, \"quantity\": 2, \"unit_price\": 1000}\n  ]\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Repayments",
            "item": [
                {
                    "name": "Create Repayment",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/v1/repayments",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"farmer_id\": 1,\n  \"amount\": 5000,\n  \"payment_method\": \"cash\"\n}"
                        }
                    }
                }
            ]
        },
        {
            "name": "Settings",
            "item": [
                {
                    "name": "Get Settings",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                        "url": "{{base_url}}/api/v1/settings"
                    }
                },
                {
                    "name": "Update Settings",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/v1/settings",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"settings\": {\n    \"interest_rate\": 0.05,\n    \"default_credit_limit\": 50000\n  }\n}"
                        }
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080"
        },
        {
            "key": "token",
            "value": ""
        }
    ]
}
