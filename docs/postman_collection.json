                        "url": "{{base_url}}/api/v1/products/1"
                    }
                },
                {
                    "name": "Category Products",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                        "url": "{{base_url}}/api/v1/categories/1/products"
                    }
                }
            ]
        },
        {
            "name": "Transactions",
            "item": [
                {
                    "name": "List Transactions",
                    "request": {
