                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/v1/farmers",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Moussa Traore\",\n  \"card_id\": \"FARM-001\",\n  \"phone\": \"+22370000001\",\n  \"credit_limit\": 50000\n}"
                        }
                    }
                },
                {
                    "name": "Update Farmer",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {"key": "Authorization", "value": "Bearer {{token}}"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "url": "{{base_url}}/api/v1/farmers/1",
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Updated Name\",\n  \"credit_limit\": 75000\n}"
                        }
                    }
                },
                {
                    "name": "Delete Farmer",
                    "request": {
                        "method": "DELETE",
                        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                        "url": "{{base_url}}/api/v1/farmers/1"
                    }
                },
                {
                    "name": "Farmer Debts",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                        "url": "{{base_url}}/api/v1/farmers/1/debts"
                    }
                },
                {
                    "name": "Farmer Transactions",
                    "request": {
                        "method": "GET",
                        "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
                        "url": "{{base_url}}/api/v1/farmers/1/transactions"
                    }
                }
            ]
        },
